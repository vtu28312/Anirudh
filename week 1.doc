TASK3:\par
import java.util.*;\par
\par
class Student \{\par
    private int id;\par
    private String fname;\par
    private double cgpa;\par
\par
    public Student(int id, String fname, double cgpa) \{\par
        this.id = id;\par
        this.fname = fname;\par
        this.cgpa = cgpa;\par
    \}\par
\par
    public int getId() \{\par
        return id;\par
    \}\par
\par
    public String getFname() \{\par
        return fname;\par
    \}\par
\par
    public double getCgpa() \{\par
        return cgpa;\par
    \}\par
\}\par
\par
class StudentComparator implements Comparator<Student> \{\par
\par
    @Override\par
    public int compare(Student a, Student b) \{\par
\par
        \par
        if (a.getCgpa() != b.getCgpa()) \{\par
            return Double.compare(b.getCgpa(), a.getCgpa());\par
        \}\par
\par
        \par
        int nameCompare = a.getFname().compareTo(b.getFname());\par
\par
        if (nameCompare != 0) \{\par
            return nameCompare;\par
        \}\par
\par
        \par
        return Integer.compare(a.getId(), b.getId());\par
    \}\par
\}\par
\par
public class Solution \{\par
\par
    public static void main(String[] args) \{\par
\par
        Scanner sc = new Scanner(System.in);\par
\par
        int n = sc.nextInt();\par
\par
        List<Student> students = new ArrayList<>();\par
\par
        for (int i = 0; i < n; i++) \{\par
            int id = sc.nextInt();\par
            String name = sc.next();\par
            double cgpa = sc.nextDouble();\par
\par
            students.add(new Student(id, name, cgpa));\par
        \}\par
\par
        Collections.sort(students, new StudentComparator());\par
\par
        for (Student student : students) \{\par
            System.out.println(student.getFname());\par
        \}\par
\par
        sc.close();\par
    \}\par
\}\par
\par
