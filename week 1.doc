TASK4:\par
class Solution \{\par
    public int[] runningSum(int[] nums) \{\par
        int sum = 0;\par
\par
        for (int i = 0; i < nums.length; i++) \{\par
            sum += nums[i];\par
            nums[i] = sum;\par
        \}\par
\par
        return nums;\par
    \}\par
\}\par
