TASK2:\par
import java.util.*;\par
\par
class Player \{\par
    String name;\par
    int score;\par
\par
    Player(String name, int score) \{\par
        this.name = name;\par
        this.score = score;\par
    \}\par
\}\par
\par
class Checker implements Comparator<Player> \{\par
\par
    @Override\par
    public int compare(Player a, Player b) \{\par
        if (a.score != b.score) \{\par
            return b.score - a.score;\par
        \}\par
\par
        return a.name.compareTo(b.name);\par
    \}\par
\}\par
\par
public class Solution \{\par
    public static void main(String[] args) \{\par
        Scanner sc = new Scanner(System.in);\par
\par
        int n = sc.nextInt();\par
        Player[] players = new Player[n];\par
\par
        for (int i = 0; i < n; i++) \{\par
            String name = sc.next();\par
            int score = sc.nextInt();\par
            players[i] = new Player(name, score);\par
        \}\par
\par
        Arrays.sort(players, new Checker());\par
\par
        for (Player p : players) \{\par
            System.out.println(p.name + " " + p.score);\par
        \}\par
\par
        sc.close();\par
    \}\par
\}\par
\par
\par
