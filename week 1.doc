TASK5:\par
class Solution \{\par
    public int maximumWealth(int[][] accounts) \{\par
        int maxWealth = 0;\par
\par
        for (int i = 0; i < accounts.length; i++) \{\par
            int wealth = 0;\par
\par
            for (int j = 0; j < accounts[i].length; j++) \{\par
                wealth += accounts[i][j];\par
            \}\par
\par
            maxWealth = Math.max(maxWealth, wealth);\par
        \}\par
\par
        return maxWealth;\par
    \}\par
\}\par
