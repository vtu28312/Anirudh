{\*\generator Riched20 10.0.19041}\viewkind4\uc1 
\pard\sa200\sl240\slmult1\f0\fs22\lang9 TASK1:\par

\pard\sa200\sl276\slmult1 import java.util.*;\par
\par
interface PerformOperation \{\par
    boolean check(int a);\par
\}\par
\par
public class Solution \{\par
\par
    public static PerformOperation isOdd() \{\par
        return n -> n % 2 != 0;\par
    \}\par
\par
    public static PerformOperation isPrime() \{\par
        return n -> \{\par
            if (n < 2) \{\par
                return false;\par
            \}\par
\par
            for (int i = 2; i * i <= n; i++) \{\par
                if (n % i == 0) \{\par
                    return false;\par
                \}\par
            \}\par
\par
            return true;\par
        \};\par
    \}\par
\par
    public static PerformOperation isPalindrome() \{\par
        return n -> \{\par
            int original = n;\par
            int reversed = 0;\par
\par
            while (n != 0) \{\par
                reversed = reversed * 10 + n % 10;\par
                n /= 10;\par
            \}\par
\par
            return original == reversed;\par
        \};\par
    \}\par
\par
    public static void main(String[] args) \{\par
        Scanner sc = new Scanner(System.in);\par
\par
        int T = sc.nextInt();\par
\par
        while (T-- > 0) \{\par
            int condition = sc.nextInt();\par
            int number = sc.nextInt();\par
\par
            PerformOperation operation;\par
\par
            if (condition == 1) \{\par
                operation = isOdd();\par
                System.out.println(operation.check(number) ? "ODD" : "EVEN");\par
            \} \par
            else if (condition == 2) \{\par
                operation = isPrime();\par
                System.out.println(operation.check(number) ? "PRIME" : "COMPOSITE");\par
            \} \par
            else \{\par
                operation = isPalindrome();\par
                System.out.println(operation.check(number) ? "PALINDROME" : "NOT PALINDROME");\par
            \}\par
        \}\par
\par
        sc.close();\par
    \}\par
\}\par

